{
	"name": "execify-cli",
	"version": "0.2.1-0",
	"description": "Easily make a Node.js CLI executable.",
	"keywords": [
		"cli",
		"cli-app",
		"command-line",
		"executable",
		"chmod",
		"chmod+x",
		"shebang",
		"hashbang",
		"typescript",
		"binary",
		"bin",
		"executable"
	],
	"license": "MIT",
	"repository": "tommy-mitchell/execify-cli",
	"author": {
		"name": "Tommy Mitchell",
		"url": "https://tommymitchell.io"
	},
	"type": "module",
	"engines": {
		"node": "^18.18 || ^20.8 || ^21"
	},
	"bin": {
		"execify": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc -p tsconfig.build.json && node dist/cli.js --all && dprint fmt --excludes '!dist'",
		"lint": "xo",
		"format": "dprint fmt && xo --fix",
		"test": "c8 ava"
	},
	"ava": {
		"files": [
			"test/*.ts"
		],
		"extensions": {
			"ts": "module"
		},
		"nodeArguments": [
			"--import=tsimp",
			"--import=esmock"
		]
	},
	"dependencies": {
		"globby": "^14.0.2",
		"meow": "^13.2.0",
		"read-package-up": "^11.0.0",
		"ts-pattern": "^5.2.0"
	},
	"devDependencies": {
		"@tommy-mitchell/dprint-config": "^0.2.0",
		"@tommy-mitchell/eslint-config-xo": "^0.3.1",
		"@tommy-mitchell/tsconfig": "^2.1.0",
		"@types/node": "^18.18",
		"ava": "^6.1.3",
		"c8": "^10.1.2",
		"copy-file": "^11.0.0",
		"cross-env": "^7.0.3",
		"dot-prop": "^9.0.0",
		"dprint": "^0.47.2",
		"esmock": "^2.6.6",
		"execa": "^9.3.0",
		"get-executable-bin-path": "^0.1.0",
		"is-executable": "^2.0.1",
		"make-executable": "^2.0.2",
		"map-obj": "^5.0.2",
		"p-map": "^7.0.2",
		"proper-tags": "^2.0.2",
		"tempy": "^3.1.0",
		"testtriple": "^2.2.3",
		"tsimp": "^2.0.11",
		"type-fest": "^4.21.0",
		"typescript": "~5.5.3",
		"xo": "^0.58.0"
	}
}
