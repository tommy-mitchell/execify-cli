{
	"name": "execify-cli",
	"version": "0.2.1-0",
	"description": "Cross-platform `chmod +x`. Easily make a Node.js CLI executable.",
	"license": "MIT",
	"repository": "tommy-mitchell/execify-cli",
	"author": "Tommy Mitchell (https://tommymitchell.io)",
	"type": "module",
	"imports": {
		"#src/*.ts": "./src/*.ts"
	},
	"bin": {
		"execify": "./dist/cli.js"
	},
	"engines": {
		"node": "^22.22 || ^24.15 || >=26"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc -p tsconfig.build.json && node dist/cli.js --pkg",
		"lint": "dprint check && xo",
		"format": "dprint fmt && xo --fix",
		"test": "c8 ava"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"cli",
		"cli-app",
		"command-line",
		"executable",
		"chmod",
		"chmod+x",
		"shebang",
		"hashbang",
		"binary",
		"bin"
	],
	"dependencies": {
		"log-symbols": "^7.0.1",
		"meow": "^14.1.0",
		"read-package-up": "^12.0.0"
	},
	"devDependencies": {
		"@tommy-mitchell/dprint-config": "^0.8.0",
		"@tommy-mitchell/eslint-config-xo": "^2.0.0-beta.11",
		"@tommy-mitchell/tsconfig": "^4.0.0",
		"@types/node": "^22.20",
		"async-sema": "^3.1.1",
		"ava": "^8.0.1",
		"c8": "^12.0.0",
		"dedent": "^1.7.2",
		"dprint": "^0.58.0",
		"execa": "^10.0.1",
		"get-executable-bin-path": "^1.0.0",
		"is-executable": "^2.0.1",
		"test-quadruple": "^1.0.0",
		"typescript": "~6.0.3",
		"xo": "^5.0.1"
	},
	"ava": {
		"extensions": [
			"ts"
		],
		"environmentVariables": {
			"concurrency": "10",
			"//": "Suppress loader warnings from esmock",
			"NODE_OPTIONS": "--disable-warning=DeprecationWarning"
		}
	}
}
